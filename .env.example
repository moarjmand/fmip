# Copy to .env and fill in. Never commit .env.
# Every variable added here must also be listed in docs/03-project-map.md.

NODE_ENV=development

# --- Database ---
# POSTGRES_* configure the container; DATABASE_URL is what the application uses
# to reach it. Keep the two in sync — nothing checks that they agree.
POSTGRES_USER=fmip
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=fmip
POSTGRES_PORT=5432
# 127.0.0.1, not localhost: on Windows, psycopg (apps/model) tries ::1 first and
# waits two minutes before falling back; node pg does not, but one spelling is
# simpler than two.
DATABASE_URL=postgresql://fmip:change_me_locally@127.0.0.1:5432/fmip

# --- Cache / queues ---
# Also the chat fan-out between API instances (T-231): without it a conversation
# still works over HTTP, but nothing is delivered live and the API says so.
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Services ---
API_PORT=3001
# apps/api log lines: json (one object per line, the production default) or pretty (the development default).
LOG_FORMAT=pretty
WEB_PORT=3000
# The public origin of the web app: canonical URLs, sitemap and structured data (T-039).
SITE_URL=http://localhost:3000
# Where apps/web reaches apps/api from the server side.
API_BASE_URL=http://127.0.0.1:3001
MODEL_SERVICE_URL=http://localhost:8000

# --- Auth ---
# At least 32 characters. Keys the HMAC of session and e-mail tokens; rotating it
# signs everyone out.
SESSION_SECRET=generate_a_long_random_string_of_at_least_32_chars
# Where the links in verification and password-reset e-mails point. Also the
# origin allowed to open a chat socket (T-230).
WEB_BASE_URL=http://localhost:3000
# Extra origins allowed to open a chat socket, comma-separated. Only needed when
# the browser reaches the socket through an edge that is not WEB_BASE_URL. A
# WebSocket handshake ignores CORS, so this list is a real access decision:
# anything named here may open a socket carrying a visitor's session.
CHAT_ALLOWED_ORIGINS=
# Where the browser opens the chat socket (T-237). Leave empty in any real
# deployment: the edge routes /me/conversations/socket to the API on the same
# origin (T-234), which is what keeps the session cookie working with no CORS.
# Set it only in development, where the web app and the API are two ports with
# nothing in front of them:
#   NEXT_PUBLIC_CHAT_SOCKET_URL=ws://localhost:3001/me/conversations/socket
NEXT_PUBLIC_CHAT_SOCKET_URL=

# --- Data providers: free tiers, for the bake-off (docs/05-data-providers.md) ---
API_FOOTBALL_KEY=
FOOTBALL_DATA_ORG_KEY=
HIGHLIGHTLY_KEY=

# --- Ingestion jobs (T-026, D-049) ---
# Which source the jobs run against:
#   replay - the committed recordings, no key and no network. The default, and
#            what CI and the tests use.
#   live   - football-data.org for fixtures, live scores and tables;
#            Highlightly for line-ups and incidents. Needs the two keys above.
#   api_football - one paid provider behind all five jobs (T-028). Needs
#            API_FOOTBALL_KEY on a plan that reaches the current season; the
#            free tier serves 2022-2024 only and this profile will look empty.
#   off    - no ingestion at all.
INGESTION_SOURCE=replay
# Only the process that should poll sets this to `on`. Two pollers on a free
# plan is the day's quota gone by lunchtime, so it is off unless asked for.
INGESTION_SCHEDULE=off
# Highlightly's free plan allows 100 requests a day; the budget is enforced in
# code, and a job that reaches it records a partial run saying so.
HIGHLIGHTLY_DAILY_BUDGET=100
# The api_football profile's ceiling, when you want the plan's daily limit
# enforced here rather than discovered at the provider mid-match. Empty means
# no ceiling of our own. A paid plan's limit is on its pricing page.
API_FOOTBALL_DAILY_BUDGET=

# --- Demonstration data (T-087, docs/11-preview.md) ---
# `on` states that the football in this deployment's database is development
# fixture data rather than real matches. The web app then puts an undismissable
# band on every page, marks every page `noindex`, empties the sitemap and has
# robots.txt forbid the whole site.
#
# It is a statement about the data, not an instruction to load it. That is why
# it is separate from PREVIEW_SEED, which is spent the moment it runs: turning
# the seed off afterwards leaves the fixtures in place, and a marker keyed on it
# would vanish while the thing it marks stayed.
#
# The preview supervisor refuses to seed unless this is `on`. Anything other
# than `on`, including absent, is a normal deployment.
DEMONSTRATION_DATA=off

# --- Backups (scripts/backup, docs/07-backups.md) ---
# Where dumps and manifests are written; git-ignored.
BACKUP_DIR=./backups
BACKUP_KEEP_LOCAL_DAYS=7
# An rclone remote on storage that is NOT the VPS provider, e.g. `offsite:`
# (a crypt remote, see the runbook). Unset = local copies only, with a warning.
BACKUP_RCLONE_REMOTE=
BACKUP_KEEP_REMOTE_DAYS=90
# rclone.conf holding that remote. Default: ~/.config/rclone/rclone.conf
BACKUP_RCLONE_CONFIG=

# --- Production only (T-074, docs/09-deploy.md) ---------------------------
# Makes every plain `docker compose` on the server mean the production stack
# (deploy/docker-compose.prod.yml). Leave unset on a development machine.
# COMPOSE_FILE=deploy/docker-compose.prod.yml
# The public host name Caddy serves and Cloudflare proxies. WEB_BASE_URL and
# SITE_URL are derived from it in the production compose file.
# SITE_HOST=fmip.example
# Caddy's published ports. Defaults 80 and 443; a laptop rehearsal uses
# 8080 and 8443.
# HTTP_PORT=80
# HTTPS_PORT=443

# --- Delivery (T-330) ------------------------------------------------------
# Which provider carries notifications out of the product, per channel. `off`
# (or unset) is an honest absence: /health/delivery reports it and the inbox
# says notifications stay in the product. A name this build cannot drive
# stops the API at boot rather than silently delivering nothing.
DELIVERY_EMAIL_PROVIDER=off
DELIVERY_PUSH_PROVIDER=off
# `smtp` (D-073) drives any transactional e-mail service by its SMTP credentials:
# SMTP_URL is the whole connection (smtps://user:pass@host:465, or smtp://host:587
# for STARTTLS) and DELIVERY_EMAIL_FROM the sender every message carries. The
# identity e-mails (verification, password reset) leave by the same channel.
SMTP_URL=
DELIVERY_EMAIL_FROM=
# `webpush` (D-074) pushes to a member's browsers through their own push
# services, signed with a VAPID key pair generated once on the server
# (`npx web-push generate-vapid-keys`); no account anywhere. VAPID_SUBJECT is a
# mailto: address or an https:// URL the push services may contact.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# The intelligence layer (Phase 5, D-070, D-072): a language model behind one port.
# `off` is an honest absence and /health/intelligence says so. Three providers:
# `anthropic` (needs ANTHROPIC_API_KEY), `mistral` (needs MISTRAL_API_KEY; the
# free Studio tier is enough for testing), and `openai_compatible` (any endpoint
# answering POST /chat/completions: needs INTELLIGENCE_BASE_URL, INTELLIGENCE_API_KEY
# and INTELLIGENCE_MODEL). A driveable provider with no key refuses to start.
# INTELLIGENCE_MODEL defaults per provider (claude-opus-5, mistral-small-latest);
# on Mistral's free plan only the Ministral models answered (2026-09-19), so set
# INTELLIGENCE_MODEL=ministral-14b-latest there. INTELLIGENCE_EFFORT is low,
# medium or high (medium: the surfaces are routine); a model that takes no
# effort says so once and is not asked again.
INTELLIGENCE_PROVIDER=off
INTELLIGENCE_MODEL=
INTELLIGENCE_EFFORT=medium
INTELLIGENCE_BASE_URL=
INTELLIGENCE_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
