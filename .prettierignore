node_modules/
dist/
build/
.next/
.turbo/
coverage/
pnpm-lock.yaml
*.tsbuildinfo

# Prose is written by hand and reviewed by hand. Reflowing it produces large
# diffs with no reader benefit, and `docs/00-decisions.md` is append-only:
# reformatting would rewrite entries that are declared immutable.
*.md

# Regenerated by `next build` on every run. Formatting it means the next build
# undoes the formatting and CI's format check fails.
next-env.d.ts

# Playwright run artifacts. Gitignored, but Prettier walks them anyway.
test-results/
playwright-report/

# Claude Code keeps a per-machine permissions file here. It is ignored by the
# user's global git excludes, which Prettier does not read, so name it here too.
.claude/

# Python tooling (apps/model); Prettier has no parser for .py and must not walk the venv.
.venv/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Machine-written backtest reports (apps/model's harnesses, the Power Index
# backtest). They are records of a run, regenerated rather than edited, and
# formatting them by hand after every run only fails CI when someone forgets.
apps/model/reports/
apps/api/backtest/
