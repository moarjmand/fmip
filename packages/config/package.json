    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "eslint": ">=9 <10",
    "prettier": ">=3",
    "typescript": ">=5.4"
  }
