    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@eslint/js": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "typescript-eslint": "^8.70.0"
  },
  "devDependencies": {
