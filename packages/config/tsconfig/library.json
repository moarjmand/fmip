{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "FMIP library (packages/*)",
  "extends": "./base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "composite": true,
    "incremental": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", ".turbo", "coverage", "**/*.spec.ts"]
}
