{
  "name": "@fmip/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "The single source of truth for the API shape. Consumed by apps/api and apps/web.",
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "sideEffects": false,
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/esm/index.js",
      "default": "./dist/index.js"
    },
    "./translation-checks": {
      "types": "./dist/translation-checks.d.ts",
      "browser": "./dist/esm/translation-checks.js",
      "default": "./dist/translation-checks.js"
    },
    "./glossary/*.json": "./glossary/*.json",
    "./zones/*.json": "./zones/*.json",
    "./console": {
      "types": "./dist/console.d.ts",
      "browser": "./dist/esm/console.js",
      "default": "./dist/console.js"
    }
  },
  "typesVersions": {
    "*": {
      "translation-checks": [
        "dist/translation-checks.d.ts"
      ],
      "console": [
        "dist/console.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "glossary",
    "zones"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.esm.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@fmip/config": "workspace:*",
    "@types/node": "^22.20.1",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
