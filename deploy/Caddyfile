# The edge inside the VPS (T-074, D-048). Cloudflare terminates the public
# TLS; this is the origin it talks to, over TLS with the Cloudflare origin
# certificate (SSL mode "Full (strict)"). Plain HTTP on :80 is redirected by
# Caddy automatically.
#
# One public origin, and almost everything behind it is `web`: the browser never
# reaches the API directly — the web app renders on the server over the compose
# network and proxies the two server-sent-event streams under /api/*.
#
# The one exception is the chat socket (T-234). A WebSocket upgrade cannot be
# proxied by a Next.js route handler — App Router handlers answer requests, not
# upgrades — so it is routed here instead, at the edge, to the same API the web
# app already talks to. The browser still sees **one origin**, which is what
# D-027 is actually about and what keeps the session cookie working with no CORS
# anywhere.
{
	admin off
}

{$SITE_HOST} {
	tls /certs/origin.pem /certs/origin.key

	# The chat socket, to the API rather than to `web` (T-234, D-055).
	#
	# An exact path, not a prefix: this is the only upgrade the API answers, and
	# a prefix would quietly hand it any future path underneath.
	@chat path /me/conversations/socket
	handle @chat {
		reverse_proxy {
			dynamic a {
				name api
				port 3001
				refresh 1s
			}
			lb_try_duration 10s
			lb_try_interval 250ms
			fail_duration 10s
			# Caddy carries an upgrade through without being told to; this is
			# here for the frames, which must not sit in a buffer.
			flush_interval -1
		}
	}

	# Everything else is the web app. A `handle` block rather than a bare
	# directive, so the two are mutually exclusive and the socket above can
	# never also be handed to `web`.
	#
	# No `encode` here on purpose: the streams under /api/* are
	# text/event-stream and must reach the browser as they are written
	# (D-034). Next compresses HTML and JSON itself and Cloudflare compresses
	# at the edge, so nothing is lost.
	handle {
		reverse_proxy {
			# Upstreams are whatever `web` resolves to in Docker's DNS,
			# refreshed every second. During a rollout that is two containers;
			# after it, the new one. This is what makes `deploy/rollout.sh`
			# zero-downtime.
			dynamic a {
				name web
				port 3000
				refresh 1s
			}
			# A dial that fails (the old container just stopped, the new one is
			# still binding) is retried against another upstream for up to 10 s
			# rather than answered with 502.
			lb_try_duration 10s
			lb_try_interval 250ms
			fail_duration 10s
			# Write every chunk through immediately: SSE, and streamed HTML.
			flush_interval -1
		}
	}

	log {
		output stdout
		format json
	}
}
