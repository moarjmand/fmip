{
  "name": "@fmip/api",
  "version": "0.0.0",
  "private": true,
  "description": "FMIP backend. NestJS on the Fastify adapter.",
  "license": "UNLICENSED",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "dev:serve": "node --watch dist/main.js",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@fmip/contracts": "workspace:*",
    "@fmip/ingestion": "workspace:*",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-fastify": "^12.0.1",
    "bullmq": "^6.3.4",
    "fastify": "5.12.1",
    "ioredis": "^5.11.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@fmip/config": "workspace:*",
    "@nestjs/testing": "^12.0.1",
    "@swc/core": "^1.16.2",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "unplugin-swc": "^1.6.0",
    "vitest": "^5.0.0"
  }
}
