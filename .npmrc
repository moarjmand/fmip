# Workspace packages are always linked from the workspace, never from the registry.
link-workspace-packages=true
prefer-workspace-packages=true

# Peer ranges are installed automatically rather than left for the consumer to
# declare. Conflicts warn instead of failing the install: the frameworks in this
# stack publish overlapping peer ranges often enough that a hard failure would
# block work for no real safety gain.
auto-install-peers=true
strict-peer-dependencies=false
